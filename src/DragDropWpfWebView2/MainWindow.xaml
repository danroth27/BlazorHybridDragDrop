<Window x:Class="DragDropWpfWebView2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:webview="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Plain WPF WebView2 Drag &amp; Drop" Height="850" Width="1050">
    <TabControl>
        <TabItem Header="Standard WebView2">
            <webview:WebView2 x:Name="StandardWebView" AllowExternalDrop="True" />
        </TabItem>
        <TabItem Header="WebView2CompositionControl">
            <webview:WebView2CompositionControl x:Name="CompositionWebView" AllowExternalDrop="True" />
        </TabItem>
    </TabControl>
</Window>
