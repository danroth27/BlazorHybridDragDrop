@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="ddt-container">
    <h1>Blazor Hybrid Drag &amp; Drop Test <span class="ddt-badge">@HostName</span></h1>
    <p class="ddt-note">
        Reproduces <a href="https://github.com/dotnet/maui/issues/2205" target="_blank">dotnet/maui#2205</a>.
        Watch the event log: the reported bug is that <code>dragstart</code> fires but
        <code>dragover</code>/<code>drop</code>/<code>dragend</code> never do.
    </p>

    <div class="ddt-env">@_env</div>

    <button class="ddt-btn secondary" @onclick="Clear">Clear log</button>

    @* ---------- Scenario 1: Native HTML5 DnD (VegasVault repro) ---------- *@
    <h2>1. Native HTML5 drag &amp; drop <span class="ddt-badge">native</span></h2>
    <p class="ddt-note">The original repro from the issue. Drag the blue box onto the green zone.</p>
    <div id="s1-source" class="ddt-source" draggable="true"
         @ondragstart="@(() => Log("[Blazor] s1 ondragstart"))">
        drag me
    </div>
    <div id="s1-target" class="ddt-target @(_s1Over ? "over" : "")"
         @ondragenter="@(() => _s1Over = true)"
         @ondragleave="@(() => _s1Over = false)"
         @ondragover:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondrop="@(() => { _s1Over = false; _s1Dropped = true; Log("[Blazor] s1 ondrop"); })">
        @(_s1Dropped ? "item dropped ✔" : "and drop me here")
    </div>

    @* ---------- Scenario 2: Native sortable list ---------- *@
    <h2>2. Native sortable list <span class="ddt-badge">native</span></h2>
    <p class="ddt-note">Reorder via native HTML5 DnD (MudBlazor DropZone / SortableJS style).</p>
    <ul class="ddt-list" id="s2">
        @for (int i = 0; i < _items.Count; i++)
        {
            var index = i;
            <li @key="_items[index]"
                draggable="true"
                class="@(_dragIndex == index ? "dragging" : "")"
                @ondragstart="@(() => { _dragIndex = index; Log($"[Blazor] s2 dragstart #{index} ({_items[index]})"); })"
                @ondragover:preventDefault="true"
                @ondrop:preventDefault="true"
                @ondrop="@(() => DropReorder(index))">
                @_items[index]
            </li>
        }
    </ul>

    @* ---------- Scenario 3: Draggable image (crash/freeze repro) ---------- *@
    <h2>3. Draggable image <span class="ddt-badge">crash repro</span></h2>
    <p class="ddt-note">
        Per the issue, dragging an image on Windows WebView2 could leave an artifact,
        freeze the UI, or crash the app. Try dragging this image around.
    </p>
    <img id="s3-img" class="ddt-img" draggable="true" alt="drag me"
         src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'><rect width='120' height='120' rx='12' fill='%23512BD4'/><text x='60' y='65' font-size='16' fill='white' text-anchor='middle'>drag me</text></svg>"
         @ondragstart="@(() => Log("[Blazor] s3 image ondragstart"))" />

    @* ---------- Scenario 4: External file drop ---------- *@
    <h2>4. Drop a file from the OS <span class="ddt-badge">file drop</span></h2>
    <p class="ddt-note">Drag a file from Explorer/Finder onto the box. Watch for <code>drop files=[...]</code>.</p>
    <div id="s4-filedrop" class="ddt-filedrop @(_s4Over ? "over" : "")"
         @ondragenter="@(() => _s4Over = true)"
         @ondragleave="@(() => _s4Over = false)"
         @ondragover:preventDefault="true"
         @ondrop:preventDefault="true"
         @ondrop="@(() => { _s4Over = false; Log("[Blazor] s4 ondrop (file names in JS log)"); })">
        Drop files here
    </div>

    @* ---------- Scenario 5: Pointer-based workaround ---------- *@
    <h2>5. Pointer-based sortable <span class="ddt-badge">workaround</span></h2>
    <p class="ddt-note">
        Does NOT use HTML5 DnD — uses pointer events, so it works on every platform
        including Android/iOS. This is the recommended workaround.
    </p>
    <ul id="s5-pointer" class="ddt-list" data-pointer-sortable>
        @foreach (var item in _pointerItems)
        {
            <li data-ps-item>@item</li>
        }
    </ul>

    <h2>Event log</h2>
    <div class="ddt-log">@string.Join("\n", _log)</div>
</div>

@code {
    [Parameter] public string HostName { get; set; } = "Unknown";

    private DotNetObjectReference<DragDropApp>? _ref;
    private IJSObjectReference? _module;
    private readonly List<string> _log = new();
    private string _env = "(loading environment…)";

    private bool _s1Over, _s1Dropped, _s4Over;
    private int _dragIndex = -1;
    private readonly List<string> _items = new() { "Item A", "Item B", "Item C", "Item D" };
    private readonly List<string> _pointerItems = new() { "One", "Two", "Three", "Four" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/DragDropShared/dragdrop.js");
        await JS.InvokeVoidAsync("dragDropTest.init", _ref);
        foreach (var id in new[] { "s1-source", "s1-target", "s2", "s3-img", "s4-filedrop" })
        {
            await JS.InvokeVoidAsync("dragDropTest.observe", id);
        }
        await JS.InvokeVoidAsync("dragDropTest.pointerSortable", "s5-pointer");

        var env = await JS.InvokeAsync<EnvInfo>("dragDropTest.environment");
        _env =
            $"Host: {HostName}\n" +
            $"UserAgent: {env.UserAgent}\n" +
            $"Platform: {env.Platform}   maxTouchPoints: {env.MaxTouchPoints}   " +
            $"PointerEvents: {env.PointerEvents}   ondragstart-in-window: {env.DragEventInWindow}";
        StateHasChanged();
    }

    [JSInvokable]
    public void OnJsLog(string message)
    {
        Log(message);
    }

    private void Log(string message)
    {
        _log.Add($"{DateTime.Now:HH:mm:ss.fff}  {message}");
        if (_log.Count > 200) _log.RemoveAt(0);
        InvokeAsync(StateHasChanged);
    }

    private void Clear()
    {
        _log.Clear();
        _s1Dropped = false;
    }

    private void DropReorder(int targetIndex)
    {
        if (_dragIndex < 0 || _dragIndex == targetIndex) { _dragIndex = -1; return; }
        var moved = _items[_dragIndex];
        _items.RemoveAt(_dragIndex);
        _items.Insert(targetIndex, moved);
        Log($"[Blazor] s2 drop: moved '{moved}' to #{targetIndex}");
        _dragIndex = -1;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch { }
        }
        _ref?.Dispose();
    }

    private sealed class EnvInfo
    {
        public string UserAgent { get; set; } = "";
        public string Platform { get; set; } = "";
        public int MaxTouchPoints { get; set; }
        public bool PointerEvents { get; set; }
        public bool DragEventInWindow { get; set; }
    }
}
